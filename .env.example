# WorkerMill Environment Configuration

# Database
DATABASE_URL=postgresql://workermill:workermill@localhost:5432/workermill

# API Server
PORT=4000
NODE_ENV=development

# Anthropic API (for AI workers)
ANTHROPIC_API_KEY=sk-ant-xxx

# AWS Configuration (for ECS/SQS orchestration - optional for local dev)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# ECS_CLUSTER_NAME=your-cluster
# AI_WORKER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/xxx/queue

# GitHub Integration (optional)
# GITHUB_TOKEN=ghp_xxx

# Task Source Integration - Jira (optional)
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=your@email.com
# JIRA_API_TOKEN=xxx

# Task Source Integration - Linear (optional)
# LINEAR_API_KEY=xxx
