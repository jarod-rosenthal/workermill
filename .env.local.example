# =============================================================================
# LOCAL WORKERMILL CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.local.example .env.local
#
# Then start local WorkerMill:
#   ./bin/local-workermill start --epic
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://workermill:localdev@localhost:5432/workermill

# -----------------------------------------------------------------------------
# EXECUTION MODE
# -----------------------------------------------------------------------------
# Set to "local" for local development (spawns local processes instead of ECS)
EXECUTION_MODE=local

# -----------------------------------------------------------------------------
# CLAUDE MAX AUTHENTICATION (Required for local mode)
# -----------------------------------------------------------------------------
# Get this by running: claude auth login
# Then copy the token from: cat ~/.claude/credentials.json
# Or run: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# -----------------------------------------------------------------------------
# LOCAL WORKER SETTINGS
# -----------------------------------------------------------------------------
# Maximum concurrent Epic Coordinators (local processes)
MAX_LOCAL_WORKERS=4

# Maximum parallel experts per task (each gets a git worktree)
MAX_PARALLEL_EXPERTS=4

# Base path for git worktrees (relative to project root or absolute)
WORKTREE_BASE_PATH=../workermill-workers

# Number of pre-created worktrees in the pool
WORKTREE_POOL_SIZE=8

# Target repository for workers to operate on
# This is the repo that AI workers will make changes to
TARGET_REPO_PATH=../my-project

# -----------------------------------------------------------------------------
# API SETTINGS
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# JWT secret for local auth (use any random string)
JWT_SECRET=local-dev-secret-change-in-production

# -----------------------------------------------------------------------------
# EPIC MODE SETTINGS
# -----------------------------------------------------------------------------
# Enable planning agent critic review (validates plans before execution)
ENABLE_CRITIC_REVIEW=true

# Max iterations for critic to request plan revisions
MAX_CRITIC_ITERATIONS=3

# Score threshold for auto-approval (0-100)
AUTO_APPROVAL_THRESHOLD=85

# Enable tech lead review of completed work
ENABLE_TECH_LEAD_REVIEW=true

# Max revision iterations for tech lead review
MAX_REVIEW_REVISIONS=3

# -----------------------------------------------------------------------------
# MEMORY SYSTEM (Optional)
# -----------------------------------------------------------------------------
# Enable memory system for enhanced context
ENABLE_MEMORY_SYSTEM=false

# Enable codebase indexing (requires additional setup)
CODEBASE_INDEXING_ENABLED=false

# -----------------------------------------------------------------------------
# SCM TOKENS (Optional - for PR creation)
# -----------------------------------------------------------------------------
# Get these from your source control provider settings
# Only needed if you want workers to create PRs

# GitHub personal access token
# GITHUB_TOKEN=

# Bitbucket repository access token
# BITBUCKET_TOKEN=

# GitLab personal access token
# GITLAB_TOKEN=

# -----------------------------------------------------------------------------
# JIRA INTEGRATION (Optional - for ticket updates)
# -----------------------------------------------------------------------------
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=

# -----------------------------------------------------------------------------
# COGNITO (Optional - only if using auth locally)
# -----------------------------------------------------------------------------
# For local development, you can skip Cognito and use direct auth
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# -----------------------------------------------------------------------------
# AWS DEPLOYMENT (Required for deploy.sh)
# -----------------------------------------------------------------------------
# These are needed when running deploy.sh locally
# AWS_ACCOUNT_ID=
# AWS_REGION=us-east-1
# PROD_CLOUDFRONT_ID=
# DEV_CLOUDFRONT_ID=
