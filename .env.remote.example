# WorkerMill Remote Agent Configuration
#
# Copy this file to .env.remote and fill in your values.
# Get your API key from the WorkerMill dashboard: Settings > Integrations

# Cloud API (required)
WORKERMILL_API_URL=https://workermill.com
WORKERMILL_API_KEY=your_org_api_key_here

# SCM tokens (set the one matching your org's SCM provider)
GITHUB_TOKEN=ghp_xxx
# BITBUCKET_TOKEN=your_bitbucket_token
# GITLAB_TOKEN=your_gitlab_token

# Agent settings (optional)
MAX_WORKERS=2
# AGENT_ID=my-machine
# POLL_INTERVAL_MS=5000
# HEARTBEAT_INTERVAL_MS=30000
