***REMOVED***!/bin/bash
***REMOVED***
***REMOVED*** Extract skills from existing task logs
***REMOVED***
***REMOVED*** Usage:
***REMOVED***   ./bin/extract-skills [options]
***REMOVED***
***REMOVED*** Options:
***REMOVED***   --days N      Look back N days (default: 30)
***REMOVED***   --max-tasks N Process up to N tasks (default: 50)
***REMOVED***   --task-id ID  Extract from a specific task ID
***REMOVED***   --dry-run     Show what would be extracted without creating skills
***REMOVED***
***REMOVED*** Requires: API_BASE_URL and API_KEY environment variables, or .env.local file

set -e

***REMOVED*** Load environment from .env.local if it exists
if [ -f ".env.local" ]; then
  export $(grep -v '^***REMOVED***' .env.local | xargs)
fi

***REMOVED*** Default values
DAYS=30
MAX_TASKS=50
TASK_ID=""
DRY_RUN=false
API_BASE_URL="${API_BASE_URL:-http://localhost:3000}"
API_KEY="${API_KEY:-}"

***REMOVED*** Parse arguments
while [[ $***REMOVED*** -gt 0 ]]; do
  case $1 in
    --days)
      DAYS="$2"
      shift 2
      ;;
    --max-tasks)
      MAX_TASKS="$2"
      shift 2
      ;;
    --task-id)
      TASK_ID="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --api-url)
      API_BASE_URL="$2"
      shift 2
      ;;
    --api-key)
      API_KEY="$2"
      shift 2
      ;;
    -h|--help)
      head -20 "$0" | tail -n +2 | sed 's/^***REMOVED*** //' | sed 's/^***REMOVED***//'
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

***REMOVED*** Check for required API key
if [ -z "$API_KEY" ]; then
  echo "Error: API_KEY environment variable is required"
  echo "Set it in .env.local or pass --api-key"
  exit 1
fi

echo "=== WorkerMill Skill Extraction ==="
echo "API: $API_BASE_URL"
echo ""

if [ -n "$TASK_ID" ]; then
  ***REMOVED*** Extract from specific task
  echo "Extracting skills from task: $TASK_ID"

  AUTO_CREATE="true"
  if [ "$DRY_RUN" = true ]; then
    AUTO_CREATE="false"
    echo "(Dry run - skills will not be created)"
  fi

  curl -s -X POST "$API_BASE_URL/api/memory/skills/extract/$TASK_ID" \
    -H "Content-Type: application/json" \
    -H "x-api-key: $API_KEY" \
    -d "{\"autoCreate\": $AUTO_CREATE, \"minConfidence\": 0.6}" | jq .
else
  ***REMOVED*** Batch extract from recent tasks
  echo "Batch extracting from tasks (last $DAYS days, max $MAX_TASKS tasks)"

  AUTO_CREATE="true"
  if [ "$DRY_RUN" = true ]; then
    AUTO_CREATE="false"
    echo "(Dry run - skills will not be created)"
  fi

  RESULT=$(curl -s -X POST "$API_BASE_URL/api/memory/skills/batch-extract" \
    -H "Content-Type: application/json" \
    -H "x-api-key: $API_KEY" \
    -d "{\"days\": $DAYS, \"maxTasks\": $MAX_TASKS, \"autoCreate\": $AUTO_CREATE}")

  echo "$RESULT" | jq .

  ***REMOVED*** Summary
  TASKS_PROCESSED=$(echo "$RESULT" | jq -r '.tasksProcessed // 0')
  SKILLS_EXTRACTED=$(echo "$RESULT" | jq -r '.totalSkillsExtracted // 0')

  echo ""
  echo "Summary:"
  echo "  Tasks processed: $TASKS_PROCESSED"
  echo "  Skills extracted: $SKILLS_EXTRACTED"
fi

echo ""
echo "Done."
