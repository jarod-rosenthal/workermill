#!/bin/bash
# =============================================================================
# Local WorkerMill - Development Environment
# =============================================================================
# Single-command startup for local WorkerMill development.
#
# Usage:
#   ./bin/local-workermill start [--workers N] [--experts N]
#   ./bin/local-workermill stop
#   ./bin/local-workermill status
#   ./bin/local-workermill create-task "Task description"
#   ./bin/local-workermill logs
#   ./bin/local-workermill reset
#
# Requirements:
#   - Docker (for PostgreSQL)
#   - Node.js >= 20
#   - Claude CLI with OAuth token (claude auth login)
# =============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
RUNTIME_DIR="$PROJECT_ROOT/.local-workermill"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Logging functions
log() { echo -e "${GREEN}[local-workermill]${NC} $1"; }
warn() { echo -e "${YELLOW}[local-workermill]${NC} $1"; }
error() { echo -e "${RED}[local-workermill]${NC} $1"; }
info() { echo -e "${BLUE}[local-workermill]${NC} $1"; }

# Show usage
usage() {
  cat <<EOF
${BOLD}Local WorkerMill - Development Environment${NC}

${CYAN}Usage:${NC}
  ./bin/local-workermill <command> [options]

${CYAN}Commands:${NC}
  start         Start local WorkerMill services
  stop          Stop all services
  status        Show status of services
  create-task   Create a test task
  logs          Tail logs from all services
  reset         Reset local database (destructive!)
  sync-data     Sync data from production database
  build-worker  Build the worker Docker image for local execution
  add-account   Save current Claude credentials to rotation pool

${CYAN}Start Options:${NC}
  --workers N      Max concurrent workers (default: 4)
  --experts N      Max parallel experts per task (default: 4)
  --skip-db        Don't start PostgreSQL (use existing)
  --skip-fe        Don't start frontend
  --no-critic      Disable critic agent review
  --no-tech-lead   Disable tech lead review
  --cognito-auth   Use real Cognito SSO instead of auto-login (requires AWS setup)
  --mock-workers   Use fast mock workers instead of Claude CLI (for E2E tests)

${CYAN}Examples:${NC}
  ./bin/local-workermill start
  ./bin/local-workermill start --workers 2 --experts 2
  ./bin/local-workermill create-task "Fix authentication bug"
  ./bin/local-workermill status
  ./bin/local-workermill logs

${CYAN}Setup:${NC}
  1. Copy .env.local.example to .env.local
  2. Run: claude auth login (to get OAuth token)
  3. Add CLAUDE_CODE_OAUTH_TOKEN to .env.local
  4. Run: ./bin/local-workermill start

EOF
}

# Load environment from .env.local
load_env() {
  if [ -f "$PROJECT_ROOT/.env.local" ]; then
    set -a
    source "$PROJECT_ROOT/.env.local"
    set +a
  fi
}

# Check OAuth token is configured
# Tries to read from credentials.json if not set in environment
check_oauth_token() {
  load_env

  # If not set, try to read from Claude credentials file
  if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
    local CREDS_FILE=""

    # Check WSL Windows path first
    if grep -qi microsoft /proc/version 2>/dev/null; then
      # Try to find Windows user profile
      for WINUSER in /mnt/c/Users/*/; do
        if [ -f "${WINUSER}.claude/.credentials.json" ]; then
          CREDS_FILE="${WINUSER}.claude/.credentials.json"
          break
        fi
      done
    fi

    # Fall back to standard Linux path
    if [ -z "$CREDS_FILE" ] && [ -f "$HOME/.claude/.credentials.json" ]; then
      CREDS_FILE="$HOME/.claude/.credentials.json"
    fi

    if [ -n "$CREDS_FILE" ] && [ -f "$CREDS_FILE" ]; then
      # Extract token using jq
      if command -v jq &>/dev/null; then
        CLAUDE_CODE_OAUTH_TOKEN=$(jq -r '.claudeAiOauth.accessToken // empty' "$CREDS_FILE" 2>/dev/null)
        if [ -n "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
          export CLAUDE_CODE_OAUTH_TOKEN
          log "OAuth token loaded from $CREDS_FILE"
          return 0
        fi
      fi
    fi
  fi

  if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
    error "OAuth token not found!"
    echo ""
    echo "To set up OAuth authentication, run:"
    echo ""
    echo "  claude auth login"
    echo ""
    echo "This will authenticate and store your token in ~/.claude/.credentials.json"
    echo "The token will be automatically loaded on next start."
    echo ""
    exit 1
  fi

  log "OAuth token configured"
}

# Check prerequisites
check_prerequisites() {
  local missing=()

  # Check Docker
  if ! command -v docker &> /dev/null; then
    missing+=("docker")
  fi

  # Check Node.js
  if ! command -v node &> /dev/null; then
    missing+=("node")
  else
    local node_version=$(node -v | cut -d'v' -f2 | cut -d'.' -f1)
    if [ "$node_version" -lt 20 ]; then
      error "Node.js >= 20 required (found: $(node -v))"
      exit 1
    fi
  fi

  # Check Claude CLI (not needed when using mock workers)
  if [ "${MOCK_WORKERS:-}" != "true" ] && ! command -v claude &> /dev/null; then
    missing+=("claude (npm install -g @anthropic-ai/claude-code)")
  fi

  if [ ${#missing[@]} -gt 0 ]; then
    error "Missing prerequisites:"
    for item in "${missing[@]}"; do
      echo "  - $item"
    done
    exit 1
  fi

  log "Prerequisites satisfied"
}

# Start PostgreSQL via Docker
start_postgres() {
  log "Starting PostgreSQL..."

  # Ensure data directory exists
  mkdir -p "$PROJECT_ROOT/data/dumps"

  docker compose -f "$PROJECT_ROOT/docker-compose.local.yml" up -d postgres

  log "Waiting for PostgreSQL to be ready..."
  local retries=30
  while [ $retries -gt 0 ]; do
    if docker exec workermill-local-db pg_isready -U workermill &> /dev/null; then
      log "PostgreSQL is ready"
      return 0
    fi
    retries=$((retries - 1))
    sleep 1
  done

  error "PostgreSQL failed to start"
  exit 1
}

# Start Redis via Docker
start_redis() {
  log "Starting Redis..."

  docker compose -f "$PROJECT_ROOT/docker-compose.local.yml" up -d redis

  local retries=15
  while [ $retries -gt 0 ]; do
    if docker exec workermill-local-redis redis-cli ping &> /dev/null; then
      log "Redis is ready"
      return 0
    fi
    retries=$((retries - 1))
    sleep 1
  done

  warn "Redis failed to start — SSE will use DB polling fallback"
}

# Run database migrations
run_migrations() {
  log "Running database migrations..."
  cd "$PROJECT_ROOT/api"

  # Load environment for DATABASE_URL
  load_env
  export DATABASE_URL="${DATABASE_URL:-postgresql://workermill:localdev@localhost:5432/workermill}"

  npm run migrate 2>&1 | grep -v "^$" || true
  log "Migrations complete"
}

# Initialize worktree pool (if TARGET_REPO_PATH is set)
init_worktrees() {
  load_env

  local target_repo="${TARGET_REPO_PATH:-}"
  local worktree_base="${WORKTREE_BASE_PATH:-../workermill-workers}"
  local pool_size="${WORKTREE_POOL_SIZE:-8}"

  if [ -z "$target_repo" ] || [ ! -d "$target_repo" ]; then
    warn "TARGET_REPO_PATH not set or doesn't exist, skipping worktree initialization"
    warn "Workers will operate on current directory"
    return 0
  fi

  log "Initializing worktree pool..."

  # Resolve paths
  local abs_worktree_base
  if [[ "$worktree_base" = /* ]]; then
    abs_worktree_base="$worktree_base"
  else
    abs_worktree_base="$PROJECT_ROOT/$worktree_base"
  fi

  local abs_target_repo
  if [[ "$target_repo" = /* ]]; then
    abs_target_repo="$target_repo"
  else
    abs_target_repo="$PROJECT_ROOT/$target_repo"
  fi

  # Ensure base directory exists
  mkdir -p "$abs_worktree_base"

  # Prune stale worktrees
  git -C "$abs_target_repo" worktree prune 2>/dev/null || true

  # Create pool
  local created=0
  for i in $(seq 0 $((pool_size - 1))); do
    local wt_path="$abs_worktree_base/worker-$i"
    if [ ! -d "$wt_path" ]; then
      log "Creating worktree: worker-$i"
      git -C "$abs_target_repo" worktree add "$wt_path" -b "local-worker-$i-init" 2>/dev/null || true
      created=$((created + 1))
    fi
  done

  if [ $created -gt 0 ]; then
    log "Created $created worktrees"
  fi
  log "Worktree pool ready ($pool_size worktrees)"
}

# Stop a service by port (only kills processes on that specific port)
stop_service_on_port() {
  local port=$1
  local name=$2
  local pids
  pids=$(lsof -ti :"$port" 2>/dev/null) || true
  if [ -n "$pids" ]; then
    echo "$pids" | xargs -r kill -9 2>/dev/null || true
    sleep 0.5
    log "Stopped previous $name on port $port"
  fi
}

# Start API server
start_api() {
  log "Starting API server..."

  mkdir -p "$RUNTIME_DIR"

  # Stop any existing API process tree (tsx watch + node children)
  if [ -f "$RUNTIME_DIR/api.pid" ]; then
    local old_pid=$(cat "$RUNTIME_DIR/api.pid")
    if kill -0 "$old_pid" 2>/dev/null; then
      kill_tree "$old_pid" TERM
      sleep 1
      kill_tree "$old_pid" KILL
      log "Stopped previous API process tree (PID: $old_pid)"
    fi
    rm -f "$RUNTIME_DIR/api.pid"
  fi
  # Safety net: kill anything still on the port
  stop_service_on_port "${PORT:-3001}" "API"

  cd "$PROJECT_ROOT/api"

  # Load environment
  load_env

  # Set execution mode: "local" skips Cognito auth, otherwise uses real Cognito
  if [ "$LOCAL_AUTH" = "true" ]; then
    export EXECUTION_MODE=local
  else
    export EXECUTION_MODE=development
  fi
  # Use DATABASE_URL from .env.local if set, otherwise default to local Docker
  export DATABASE_URL="${DATABASE_URL:-postgresql://workermill:localdev@localhost:5432/workermill}"
  export PORT="${PORT:-3001}"
  export NODE_ENV=development
  # Allow self-signed certs for local dev (RDS via bastion tunnel)
  export NODE_TLS_REJECT_UNAUTHORIZED="${NODE_TLS_REJECT_UNAUTHORIZED:-0}"
  # Pass through OAuth token for containers
  export CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}"
  # SCM tokens are fetched from AWS Secrets Manager at runtime.
  # Only export if explicitly set in .env.local (don't export empty strings
  # which would mask "undefined" and break fallback detection in Node.js)
  [ -n "${GITHUB_TOKEN:-}" ] && export GITHUB_TOKEN
  [ -n "${BITBUCKET_TOKEN:-}" ] && export BITBUCKET_TOKEN
  # Redis for real-time coordination pub/sub (no TLS locally)
  export REDIS_URL="${REDIS_URL:-redis://localhost:6379}"
  # Ollama: resolve WSL2 gateway IP to reach Windows-hosted Ollama
  export OLLAMA_HOST="${OLLAMA_HOST:-http://$(ip route show default | awk '{print $3}'):11434}"

  # Start API in background
  npm run dev > "$RUNTIME_DIR/api.log" 2>&1 &
  echo $! > "$RUNTIME_DIR/api.pid"

  # Wait for API to be ready
  local retries=30
  while [ $retries -gt 0 ]; do
    if curl -s "http://localhost:${PORT}/health" > /dev/null 2>&1; then
      log "API server ready (PID: $(cat "$RUNTIME_DIR/api.pid"))"
      return 0
    fi
    retries=$((retries - 1))
    sleep 1
  done

  warn "API server started but health check not responding yet"
  log "API server started (PID: $(cat "$RUNTIME_DIR/api.pid"))"
}

# Start frontend
start_frontend() {
  log "Starting frontend..."

  mkdir -p "$RUNTIME_DIR"

  # Stop any existing frontend process tree first
  if [ -f "$RUNTIME_DIR/frontend.pid" ]; then
    local old_pid=$(cat "$RUNTIME_DIR/frontend.pid")
    if kill -0 "$old_pid" 2>/dev/null; then
      kill_tree "$old_pid" TERM
      sleep 0.5
      kill_tree "$old_pid" KILL
      log "Stopped previous frontend process tree (PID: $old_pid)"
    fi
    rm -f "$RUNTIME_DIR/frontend.pid"
  fi
  # Safety net: kill anything still on the ports
  stop_service_on_port 5173 "frontend"
  stop_service_on_port 5174 "frontend (stale)"

  cd "$PROJECT_ROOT/frontend"

  # Use empty API URL so requests go through Vite proxy (works from any device on LAN)
  export VITE_API_URL=""
  if [ "$LOCAL_AUTH" = "true" ]; then
    export VITE_LOCAL_MODE="true"
  fi

  npx vite --host > "$RUNTIME_DIR/frontend.log" 2>&1 &
  echo $! > "$RUNTIME_DIR/frontend.pid"

  sleep 2

  # Verify frontend landed on port 5173 (not 5174 due to zombie)
  if lsof -ti :5173 > /dev/null 2>&1; then
    log "Frontend started on port 5173 (PID: $(cat "$RUNTIME_DIR/frontend.pid"))"
  elif lsof -ti :5174 > /dev/null 2>&1; then
    warn "Frontend started on port 5174 instead of 5173 — zombie process may exist"
    log "Frontend started (PID: $(cat "$RUNTIME_DIR/frontend.pid"))"
  else
    warn "Frontend process started but not listening yet"
    log "Frontend started (PID: $(cat "$RUNTIME_DIR/frontend.pid"))"
  fi
}

# Build worker Docker image
cmd_build_worker() {
  log "Building worker Docker image..."
  echo ""

  cd "$PROJECT_ROOT/worker"

  # Build the image with local tag
  docker build --no-cache -t workermill-worker:local .

  if [ $? -eq 0 ]; then
    log "Worker image built successfully!"
    echo ""
    docker images workermill-worker:local
    echo ""
    log "You can now run: ./bin/local-workermill start"
  else
    error "Failed to build worker image"
    exit 1
  fi
}

# Check if worker image exists
check_worker_image() {
  if ! docker image inspect workermill-worker:local &>/dev/null; then
    error "Worker image 'workermill-worker:local' not found!"
    echo ""
    echo "Build it first with:"
    echo "  ./bin/local-workermill build-worker"
    echo ""
    exit 1
  fi
  log "Worker image found"
}

# Main start command
cmd_start() {
  # Defaults
  local skip_db=false
  local skip_fe=false
  local max_workers=4
  local max_experts=4
  local enable_critic=true
  local enable_tech_lead=true
  local local_auth=true
  local mock_workers=false

  # Parse options
  while [[ $# -gt 0 ]]; do
    case $1 in
      --skip-db) skip_db=true; shift ;;
      --skip-fe) skip_fe=true; shift ;;
      --workers) max_workers=$2; shift 2 ;;
      --experts) max_experts=$2; shift 2 ;;
      --no-critic) enable_critic=false; shift ;;
      --no-tech-lead) enable_tech_lead=false; shift ;;
      --local-auth) local_auth=true; shift ;;
      --cognito-auth) local_auth=false; shift ;;
      --mock-workers) mock_workers=true; shift ;;
      *) shift ;;
    esac
  done

  # Export for start_api() and start_frontend() to read
  export LOCAL_AUTH=$local_auth
  export MOCK_WORKERS=$mock_workers

  # Export settings for child processes
  export MAX_LOCAL_WORKERS=$max_workers
  export MAX_PARALLEL_EXPERTS=$max_experts
  export ENABLE_CRITIC_REVIEW=$enable_critic
  export ENABLE_TECH_LEAD_REVIEW=$enable_tech_lead

  echo ""
  info "========================================================================"
  info "                      LOCAL WORKERMILL                                  "
  info "========================================================================"
  echo ""

  # Pre-flight checks
  check_prerequisites
  if [ "$mock_workers" != "true" ]; then
    check_oauth_token
    check_worker_image
  else
    log "Mock worker mode — skipping OAuth and worker image checks"
  fi

  # Start services
  if [ "$skip_db" = false ]; then
    start_postgres
    run_migrations
  fi

  start_redis
  init_worktrees
  start_api

  if [ "$skip_fe" = false ]; then
    start_frontend
  fi

  # Print summary
  echo ""
  log "========================================================================"
  log "  Local WorkerMill is running!"
  log ""
  log "  API:          http://localhost:${PORT:-3001}"
  if [ "$skip_fe" = false ]; then
    log "  Frontend:     http://localhost:5173"
  fi
  log "  Redis:        redis://localhost:6379"
  log ""
  log "  Auth:         $([ "$local_auth" = "true" ] && echo "local (auto-login)" || echo "Cognito")"
  log "  Mock Workers: $mock_workers"
  log "  Workers:      $max_workers max concurrent"
  log "  Experts:      $max_experts per task"
  log "  Critic:       $enable_critic"
  log "  Tech Lead:    $enable_tech_lead"
  log ""
  log "  Commands:"
  log "    ./bin/local-workermill create-task 'Your task'"
  log "    ./bin/local-workermill status"
  log "    ./bin/local-workermill logs"
  log "    ./bin/local-workermill stop"
  log "========================================================================"
  echo ""
}

# Kill a process and its entire descendant tree
kill_tree() {
  local pid=$1
  local sig=${2:-TERM}
  # Kill children recursively first
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    kill_tree "$child" "$sig"
  done
  kill -"$sig" "$pid" 2>/dev/null || true
}

# Stop all services
cmd_stop() {
  log "Stopping local WorkerMill..."

  # Stop worker containers first (NOT the database or Redis)
  local containers=$(docker ps --filter "name=workermill-" --format "{{.ID}} {{.Names}}" 2>/dev/null | grep -v -e workermill-local-db -e workermill-local-redis | awk '{print $1}')
  if [ -n "$containers" ]; then
    log "Stopping worker containers..."
    docker stop $containers 2>/dev/null || true
    log "Worker containers stopped"
  fi

  # Stop API (kill entire process tree — tsx watch, node, and spawned Claude CLI)
  if [ -f "$RUNTIME_DIR/api.pid" ]; then
    local pid=$(cat "$RUNTIME_DIR/api.pid")
    if kill -0 "$pid" 2>/dev/null; then
      kill_tree "$pid" TERM
      # Wait briefly, then force-kill any survivors
      sleep 1
      kill_tree "$pid" KILL
      log "API stopped"
    fi
    rm -f "$RUNTIME_DIR/api.pid"
  fi

  # Stop frontend (kill process tree)
  if [ -f "$RUNTIME_DIR/frontend.pid" ]; then
    local pid=$(cat "$RUNTIME_DIR/frontend.pid")
    if kill -0 "$pid" 2>/dev/null; then
      kill_tree "$pid" TERM
      sleep 0.5
      kill_tree "$pid" KILL
      log "Frontend stopped"
    fi
    rm -f "$RUNTIME_DIR/frontend.pid"
  fi

  # PostgreSQL and Redis are LEFT RUNNING intentionally — restarting them is
  # slow and loses session state.  Use "docker compose -f docker-compose.local.yml down"
  # manually if you really need to stop infrastructure services.

  log "All services stopped (database + Redis left running)"
}

# Show status
cmd_status() {
  echo ""
  info "========================================================================"
  info "                 LOCAL WORKERMILL STATUS                                "
  info "========================================================================"
  echo ""

  # PostgreSQL status
  if docker ps 2>/dev/null | grep -q workermill-local-db; then
    echo -e "PostgreSQL:    ${GREEN}running${NC}"
  else
    echo -e "PostgreSQL:    ${RED}stopped${NC}"
  fi

  # Redis status
  if docker ps 2>/dev/null | grep -q workermill-local-redis; then
    echo -e "Redis:         ${GREEN}running${NC}"
  else
    echo -e "Redis:         ${YELLOW}stopped${NC} (SSE will use DB polling fallback)"
  fi

  # API status
  if [ -f "$RUNTIME_DIR/api.pid" ] && kill -0 $(cat "$RUNTIME_DIR/api.pid") 2>/dev/null; then
    local api_pid=$(cat "$RUNTIME_DIR/api.pid")
    echo -e "API:           ${GREEN}running${NC} (PID: $api_pid)"
  else
    echo -e "API:           ${RED}stopped${NC}"
  fi

  # Frontend status
  if [ -f "$RUNTIME_DIR/frontend.pid" ] && kill -0 $(cat "$RUNTIME_DIR/frontend.pid") 2>/dev/null; then
    local fe_pid=$(cat "$RUNTIME_DIR/frontend.pid")
    echo -e "Frontend:      ${GREEN}running${NC} (PID: $fe_pid)"
  else
    echo -e "Frontend:      ${RED}stopped${NC}"
  fi

  # OAuth token - check env and credentials file
  load_env
  local oauth_status="${RED}not set${NC}"
  if [ -n "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
    oauth_status="${GREEN}configured${NC} (from .env.local)"
  else
    # Check credentials file
    local CREDS_FILE=""
    if grep -qi microsoft /proc/version 2>/dev/null; then
      for WINUSER in /mnt/c/Users/*/; do
        if [ -f "${WINUSER}.claude/.credentials.json" ]; then
          CREDS_FILE="${WINUSER}.claude/.credentials.json"
          break
        fi
      done
    fi
    if [ -z "$CREDS_FILE" ] && [ -f "$HOME/.claude/.credentials.json" ]; then
      CREDS_FILE="$HOME/.claude/.credentials.json"
    fi
    if [ -n "$CREDS_FILE" ] && [ -f "$CREDS_FILE" ]; then
      if command -v jq &>/dev/null; then
        local token=$(jq -r '.claudeAiOauth.accessToken // empty' "$CREDS_FILE" 2>/dev/null)
        if [ -n "$token" ]; then
          oauth_status="${GREEN}configured${NC} (from credentials.json)"
        fi
      fi
    fi
  fi
  echo -e "OAuth Token:   $oauth_status"

  # Worker image
  if docker image inspect workermill-worker:local &>/dev/null; then
    echo -e "Worker Image:  ${GREEN}built${NC}"
  else
    echo -e "Worker Image:  ${RED}not built${NC} (run: ./bin/local-workermill build-worker)"
  fi

  # Running worker containers
  local containers=$(docker ps --filter "name=workermill-" --format "{{.Names}}" 2>/dev/null | wc -l)
  if [ "$containers" -gt 0 ]; then
    echo -e "Containers:    ${GREEN}$containers running${NC}"
    docker ps --filter "name=workermill-" --format "  - {{.Names}} ({{.Status}})" 2>/dev/null
  else
    echo -e "Containers:    ${YELLOW}none running${NC}"
  fi

  # Worktrees
  echo ""
  echo "Worktrees:"
  load_env
  local target_repo="${TARGET_REPO_PATH:-}"
  if [ -n "$target_repo" ] && [ -d "$target_repo" ]; then
    git -C "$target_repo" worktree list 2>/dev/null | head -10 || echo "  (none)"
  else
    echo "  (target repo not configured)"
  fi

  echo ""
}

# Create a test task
cmd_create_task() {
  local title="${1:-Test Task}"
  local description="${2:-This is a test task for local WorkerMill development}"

  load_env
  local port="${PORT:-3001}"

  log "Creating task: $title"

  # Get org API key from database (or use default)
  local api_key
  api_key=$(docker exec workermill-local-db psql -U workermill -d workermill -t -c \
    "SELECT api_key FROM organizations LIMIT 1" 2>/dev/null | tr -d ' \n') || true

  if [ -z "$api_key" ]; then
    api_key="local-dev-key"
    warn "No org found in database, using default key"
  fi

  # Generate a unique local task ID
  local local_key="LOCAL-$(date +%s)"

  # Create task via API
  local response
  response=$(curl -s -X POST "http://localhost:${port}/api/tasks" \
    -H "Content-Type: application/json" \
    -H "X-API-Key: $api_key" \
    -d "{
      \"title\": \"$title\",
      \"description\": \"$description\",
      \"persona\": \"backend_developer\",
      \"jiraIssueKey\": \"$local_key\",
      \"labels\": [\"workermill\"]
    }" 2>&1)

  if echo "$response" | grep -q '"id"'; then
    log "Task created successfully!"
    echo "$response" | jq . 2>/dev/null || echo "$response"
    echo ""
    log "Monitor at: http://localhost:5173"
  else
    error "Failed to create task:"
    echo "$response"
  fi
}

# Tail logs
cmd_logs() {
  if [ ! -d "$RUNTIME_DIR" ]; then
    error "No runtime directory found. Is WorkerMill running?"
    exit 1
  fi

  log "Tailing logs (Ctrl+C to stop)..."
  echo ""

  tail -f "$RUNTIME_DIR/api.log" "$RUNTIME_DIR/frontend.log" 2>/dev/null || \
    tail -f "$RUNTIME_DIR/api.log" 2>/dev/null || \
    error "No log files found"
}

# Reset database
cmd_reset() {
  error "The reset command has been disabled to prevent accidental data loss."
  error "If you really need to reset, manually run:"
  error "  docker compose -f docker-compose.local.yml down -v"
  exit 1
}

# Add current credentials to rotation pool
cmd_add_account() {
  # Warn if tasks are running — switching accounts overwrites credentials.json
  # which is bind-mounted into running containers
  local containers=$(docker ps -q --filter "name=workermill-" 2>/dev/null)
  if [ -n "$containers" ]; then
    warn "WARNING: Worker containers are running!"
    warn "Switching Claude accounts will disrupt running tasks."
    warn "Stop tasks first: ./bin/local-workermill stop"
    echo ""
    read -p "Continue anyway? (y/N) " confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
      echo "Aborted."
      exit 0
    fi
  fi

  # Find credentials file (same logic as check_oauth_token)
  local CREDS_FILE=""
  local CLAUDE_DIR=""

  if grep -qi microsoft /proc/version 2>/dev/null; then
    for WINUSER in /mnt/c/Users/*/; do
      if [ -f "${WINUSER}.claude/.credentials.json" ]; then
        CREDS_FILE="${WINUSER}.claude/.credentials.json"
        CLAUDE_DIR="${WINUSER}.claude"
        break
      fi
    done
  fi

  if [ -z "$CREDS_FILE" ] && [ -f "$HOME/.claude/.credentials.json" ]; then
    CREDS_FILE="$HOME/.claude/.credentials.json"
    CLAUDE_DIR="$HOME/.claude"
  fi

  if [ -z "$CREDS_FILE" ] || [ ! -f "$CREDS_FILE" ]; then
    error "No credentials found. Sign into Claude first (run 'claude' and complete OAuth)."
    exit 1
  fi

  local POOL_DIR="$CLAUDE_DIR/.credentials-pool"
  mkdir -p "$POOL_DIR"

  # Find next available index
  local INDEX=0
  while [ -f "$POOL_DIR/account-$INDEX.json" ]; do
    INDEX=$((INDEX + 1))
  done

  cp "$CREDS_FILE" "$POOL_DIR/account-$INDEX.json"

  # Read account tier for display (best-effort)
  local TIER="unknown"
  if command -v jq &>/dev/null; then
    TIER=$(jq -r '.claudeAiOauth.rateLimitTier // "unknown"' "$CREDS_FILE" 2>/dev/null) || TIER="unknown"
  fi

  log "Saved account $INDEX (tier: $TIER) to credential pool"
  log "Pool now has $((INDEX + 1)) account(s)"
  echo ""
  echo "  Pool directory: $POOL_DIR"
  ls -la "$POOL_DIR"/account-*.json 2>/dev/null
  echo ""

  # After adding a second+ account, restore account-0 as the active credentials
  # so that running tasks (bind-mounted) don't lose auth
  if [ "$INDEX" -gt 0 ] && [ -f "$POOL_DIR/account-0.json" ]; then
    cp "$POOL_DIR/account-0.json" "$CREDS_FILE"
    log "Restored account-0 as active credentials (safe for running tasks)"
  fi

  info "To add another account:"
  echo "  1. Sign into a different Claude account (run 'claude' and re-authenticate)"
  echo "  2. ./bin/local-workermill add-account"
  echo ""
  info "Worker image rebuild required after first setup:"
  echo "  ./bin/local-workermill build-worker"
}

# Sync data from production
cmd_sync_data() {
  log "Syncing data from production..."
  warn "This requires the bastion SSH tunnel to be active!"
  echo ""
  echo "1. In another terminal, run: ./bin/bastion ssh"
  echo "2. Once connected, press Enter here to continue"
  read -p "Press Enter when ready..."

  mkdir -p "$PROJECT_ROOT/data/dumps"
  local dump_file="$PROJECT_ROOT/data/dumps/prod-$(date +%Y%m%d-%H%M%S).sql"

  # Get password from AWS Secrets Manager
  local db_pass
  db_pass=$(aws secretsmanager get-secret-value \
    --secret-id "${WM_SECRETS_PREFIX:-workermill/${ENVIRONMENT:-dev}}/database-url" \
    --query 'SecretString' --output text 2>/dev/null | \
    sed 's/.*:\([^@]*\)@.*/\1/') || true

  if [ -z "$db_pass" ]; then
    error "Could not get database password from AWS Secrets Manager"
    echo "Make sure you have AWS credentials configured"
    exit 1
  fi

  log "Dumping production database..."
  PGPASSWORD="$db_pass" pg_dump -h localhost -p 5432 -U workermill -d workermill \
    --no-owner --no-acl -f "$dump_file"

  log "Restoring to local database..."
  docker exec -i workermill-local-db psql -U workermill -d workermill < "$dump_file"

  log "Data sync complete!"
  log "Dump saved to: $dump_file"
}

# Main entry point
case "${1:-}" in
  start)        shift; cmd_start "$@" ;;
  stop)         cmd_stop ;;
  status)       cmd_status ;;
  create-task)  shift; cmd_create_task "$@" ;;
  logs)         cmd_logs ;;
  reset)        cmd_reset ;;
  sync-data)    cmd_sync_data ;;
  build-worker) cmd_build_worker ;;
  add-account)  cmd_add_account ;;
  -h|--help|help) usage ;;
  *)
    if [ -n "${1:-}" ]; then
      error "Unknown command: $1"
      echo ""
    fi
    usage
    exit 1
    ;;
esac
