***REMOVED***!/usr/bin/env bash
***REMOVED***
***REMOVED*** WorkerMill Remote Agent
***REMOVED***
***REMOVED*** Runs a lightweight agent that polls the cloud WorkerMill API for tasks,
***REMOVED*** runs planning locally via Claude CLI, and spawns Docker worker containers
***REMOVED*** that report back to the cloud dashboard.
***REMOVED***
***REMOVED*** Prerequisites:
***REMOVED***   - Docker (with workermill-worker:local image built)
***REMOVED***   - Claude CLI (npm install -g @anthropic-ai/claude-code)
***REMOVED***   - Claude Max subscription (claude auth login)
***REMOVED***   - .env.remote configured with API URL and key
***REMOVED***
***REMOVED*** Usage:
***REMOVED***   ./bin/remote-agent

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
AGENT_DIR="$PROJECT_ROOT/agent"
ENV_FILE="$PROJECT_ROOT/.env.remote"

***REMOVED*** Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}WorkerMill Remote Agent${NC}"
echo "========================"
echo

***REMOVED*** Check .env.remote exists
if [ ! -f "$ENV_FILE" ]; then
    echo -e "${RED}Error: .env.remote not found${NC}"
    echo
    echo "Create .env.remote with:"
    echo "  WORKERMILL_API_URL=https://workermill.com"
    echo "  WORKERMILL_API_KEY=your_org_api_key"
    echo "  GITHUB_TOKEN=ghp_xxx  ***REMOVED*** or BITBUCKET_TOKEN / GITLAB_TOKEN"
    echo "  MAX_WORKERS=2"
    exit 1
fi

***REMOVED*** Check Docker
if ! command -v docker &> /dev/null; then
    echo -e "${RED}Error: Docker is not installed${NC}"
    exit 1
fi

if ! docker info &> /dev/null 2>&1; then
    echo -e "${RED}Error: Docker is not running${NC}"
    exit 1
fi

***REMOVED*** Check worker image
if ! docker image inspect workermill-worker:local &> /dev/null 2>&1; then
    echo -e "${YELLOW}Worker image not found. Building...${NC}"
    "$SCRIPT_DIR/local-workermill" build-worker
fi

***REMOVED*** Check Claude CLI
if ! command -v claude &> /dev/null; then
    echo -e "${RED}Error: Claude CLI not found${NC}"
    echo "Install with: npm install -g @anthropic-ai/claude-code"
    exit 1
fi

***REMOVED*** Check Claude credentials
CLAUDE_CREDS="$HOME/.claude/.credentials.json"
if [ ! -f "$CLAUDE_CREDS" ]; then
    echo -e "${RED}Error: Claude credentials not found${NC}"
    echo "Run: claude auth login"
    exit 1
fi

***REMOVED*** Install dependencies if needed
if [ ! -d "$AGENT_DIR/node_modules" ]; then
    echo -e "${YELLOW}Installing agent dependencies...${NC}"
    (cd "$AGENT_DIR" && npm install)
    echo
fi

***REMOVED*** Load .env.remote and start the agent
echo -e "${GREEN}Starting remote agent...${NC}"
echo

***REMOVED*** Export env vars from .env.remote (dotenv handles this too, but belt-and-suspenders)
set -a
source "$ENV_FILE"
set +a

exec npx --prefix "$AGENT_DIR" tsx "$AGENT_DIR/src/index.ts"
