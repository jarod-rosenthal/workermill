{
  "name": "workermill",
  "version": "0.1.0",
  "description": "AI coding agent with multi-expert orchestration. Works with any LLM provider.",
  "type": "module",
  "bin": {
    "workermill": "./dist/index.js",
    "wm": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean --banner.js '#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/openai-compatible": "^2.0.37",
    "ai": "^6.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["ai", "coding", "agent", "cli", "ollama", "anthropic", "openai"],
  "license": "MIT"
}
