{
  "name": "workermill",
  "version": "0.15.16",
  "description": "AI coding agent with multi-expert orchestration. Works with any LLM provider.",
  "type": "module",
  "bin": {
    "workermill": "dist/index.js",
    "wm": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/openai-compatible": "^2.0.37",
    "ai": "^6.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "marked": "^17.0.5",
    "marked-terminal": "^7.3.0",
    "ollama-ai-provider-v2": "^3.5.0",
    "ora": "^8.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "picomatch": "^4.0.4"
  },
  "engines": {
