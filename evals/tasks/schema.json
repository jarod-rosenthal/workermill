{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workermill.dev/evals/task.schema.json",
  "type": "object",
  "required": ["taskId", "category", "initialRevision", "prompt", "workspace", "acceptance", "rubric"],
  "properties": {
    "taskId": { "type": "string", "pattern": "^r20-[a-z0-9-]+-v[0-9]+$" },
    "category": { "enum": ["bugfix", "feature", "refactor", "maintenance", "security"] },
    "initialRevision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "prompt": { "type": "string", "minLength": 1 },
    "workspace": {
      "type": "object",
      "required": ["files", "writableFiles", "network", "timeoutMs", "toolchain"],
      "properties": {
        "files": { "type": "object", "additionalProperties": { "type": "string" } },
        "writableFiles": { "type": "array", "items": { "type": "string" } },
        "network": { "const": false },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "toolchain": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "acceptance": { "type": "string", "minLength": 1 },
    "rubric": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
