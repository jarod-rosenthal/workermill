# WorkerMill Mobile App — Environment Variables
# Copy to .env.local and fill in values.

# Required: Cognito app client ID (no secret — public client).
# AWS Console → Cognito → User Pools → App clients → App client ID.
EXPO_PUBLIC_COGNITO_CLIENT_ID=

# Optional: Override API base URL (defaults to https://workermill.com/api).
# EXPO_PUBLIC_API_BASE_URL=
