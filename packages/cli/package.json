{
  "name": "@workermill/cli",
  "version": "0.1.0",
  "description": "WorkerMill CLI — manage local AI workers that execute stories from workermill.com",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "workermill": "dist/cli.js"
  },
  "files": [
