{
  "name": "workermill",
  "displayName": "WorkerMill",
  "description": "Watch AI experts build your project — real-time monitoring and control for your WorkerMill AI engineering team",
  "version": "0.2.134",
  "publisher": "workermill",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jarod-rosenthal/workermill"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding",
    "agents",
    "workermill",
    "automation",
    "jira"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWalkthrough:workermill.getStarted"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workermill",
          "title": "WorkerMill",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "workermill": [
        {
          "id": "workermill.teamPanel",
          "name": "Team"
        },
        {
          "id": "workermill.feedPanel",
          "name": "Activity",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "workermill.runTask",
        "title": "WorkerMill: Run Task..."
      },
      {
        "command": "workermill.runIssue",
        "title": "WorkerMill: Run Issue",
        "icon": "$(play)"
      },
      {
        "command": "workermill.talkToWorker",
        "title": "WorkerMill: Talk to Worker..."
      },
      {
        "command": "workermill.showTeamPanel",
        "title": "WorkerMill: Show Team Panel"
      },
      {
        "command": "workermill.showTaskLogs",
        "title": "WorkerMill: Show Task Logs"
      },
      {
        "command": "workermill.approvePlan",
        "title": "WorkerMill: Approve Plan"
      },
      {
        "command": "workermill.newTask",
        "title": "WorkerMill: New Task",
        "icon": "$(add)"
      },
      {
        "command": "workermill.refreshTasks",
        "title": "WorkerMill: Refresh Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "workermill.openLiveDiff",
        "title": "WorkerMill: Live Code Changes",
        "icon": "$(eye)"
      },
      {
        "command": "workermill.searchIssues",
        "title": "WorkerMill: Search Issues...",
        "icon": "$(search)"
      },
      {
        "command": "workermill.filterBacklog",
        "title": "WorkerMill: Filter Backlog...",
        "icon": "$(filter)"
      },
      {
        "command": "workermill.installAgent",
        "title": "WorkerMill: Install/Update Agent"
      },
      {
        "command": "workermill.startAgent",
        "title": "WorkerMill: Start Agent",
        "icon": "$(play)"
      },
      {
        "command": "workermill.stopAgent",
        "title": "WorkerMill: Stop Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "workermill.restartAgent",
        "title": "WorkerMill: Restart Agent",
        "icon": "$(debug-restart)"
      },
      {
        "command": "workermill.cancelTask",
        "title": "WorkerMill: Cancel Task",
        "icon": "$(debug-stop)"
      },
      {
        "command": "workermill.deleteCard",
        "title": "WorkerMill: Delete Card",
        "icon": "$(trash)"
      },
      {
        "command": "workermill.deleteTask",
        "title": "WorkerMill: Delete Task",
        "icon": "$(trash)"
      },
      {
        "command": "workermill.signUpWithGitHub",
        "title": "WorkerMill: Sign Up with GitHub"
      },
      {
        "command": "workermill.signInWithGitHub",
        "title": "WorkerMill: Sign In with GitHub"
      },
      {
        "command": "workermill.signInWithGoogle",
        "title": "WorkerMill: Sign In with Google"
      },
      {
        "command": "workermill.signInWithEmail",
        "title": "WorkerMill: Sign In with Email"
      },
      {
        "command": "workermill.configureScm",
        "title": "Configure Repository Access",
        "category": "WorkerMill"
      },
      {
        "command": "workermill.buildFromPrd",
        "title": "WorkerMill: Product Build",
        "icon": "$(rocket)"
      },
      {
        "command": "workermill.runFileAsTask",
        "title": "WorkerMill: Run as Task",
        "icon": "$(play)"
      },
      {
        "command": "workermill.openDashboard",
        "title": "WorkerMill: Open Dashboard",
        "icon": "$(link-external)"
      },
      {
        "command": "workermill.connectAgent",
        "title": "WorkerMill: Connect Agent"
      },
      {
        "command": "workermill.openSettings",
        "title": "WorkerMill: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "workermill.signOut",
        "title": "WorkerMill: Sign Out",
        "icon": "$(sign-out)"
      },
      {
        "command": "workermill.liveDiffPicker",
        "title": "WorkerMill: Browse Live Code Changes",
        "icon": "$(list-flat)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workermill.newTask",
          "when": "view == workermill.teamPanel && workermill.agentConnected",
          "group": "navigation@0"
        },
        {
          "command": "workermill.filterBacklog",
          "when": "view == workermill.teamPanel && workermill.agentConfigured",
          "group": "navigation@1"
        },
        {
          "command": "workermill.searchIssues",
          "when": "view == workermill.teamPanel && workermill.agentConfigured",
          "group": "navigation@2"
        },
        {
          "command": "workermill.refreshTasks",
          "when": "view == workermill.teamPanel && workermill.agentConfigured",
          "group": "navigation@3"
        },
        {
          "command": "workermill.openSettings",
          "when": "view == workermill.teamPanel && workermill.agentConfigured",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "workermill.runIssue",
          "when": "viewItem == issue",
          "group": "inline@1"
        },
        {
          "command": "workermill.deleteCard",
          "when": "viewItem == issue || viewItem == issue-blocked",
          "group": "inline@2"
        },
        {
          "command": "workermill.deleteCard",
          "when": "viewItem == issue || viewItem == issue-blocked",
          "group": "destructive"
        },
        {
          "command": "workermill.deleteTask",
          "when": "viewItem == task-pr_approved || viewItem == task-completed || viewItem == task-failed || viewItem == task-cancelled",
          "group": "inline@2"
        },
        {
          "command": "workermill.deleteTask",
          "when": "viewItem == task-pr_approved || viewItem == task-completed || viewItem == task-failed || viewItem == task-cancelled",
          "group": "destructive"
        },
        {
          "command": "workermill.openLiveDiff",
          "when": "viewItem == task-running || viewItem == task-planning",
          "group": "inline"
        },
        {
          "command": "workermill.cancelTask",
          "when": "viewItem == task-running || viewItem == task-planning",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "workermill.runTask",
          "group": "workermill@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "workermill.buildFromPrd",
          "when": "resourceExtname == .md",
          "group": "workermill@1"
        },
        {
          "command": "workermill.runFileAsTask",
          "when": "resourceExtname == .md",
          "group": "workermill@2"
        }
      ],
      "editor/title": [
        {
          "command": "workermill.buildFromPrd",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "workermill.buildFromPrd",
          "when": "resourceExtname == .md",
          "group": "workermill@1"
        },
        {
          "command": "workermill.runFileAsTask",
          "when": "resourceExtname == .md",
          "group": "workermill@2"
        }
      ]
    },
    "configuration": {
      "title": "WorkerMill",
      "properties": {
        "workermill.issueStatusFilter": {
          "type": "string",
          "default": "",
          "description": "Only show issues with this status in the Backlog. Leave empty to show all open issues."
        },
        "workermill.maxPerStoryRevisions": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "Max tech lead review revisions per story. Set to 0 to skip per-story review."
        },
        "workermill.maxReviewRevisions": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Max tech lead review revisions on the consolidated PR. Set to 0 to skip PR review."
        },
        "workermill.maxFixRetries": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 20,
          "description": "Max fix retry attempts (quality gate + CI) before failing."
        },
        "workermill.blockerWaitTimeoutMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 120,
          "description": "Minutes to wait for human blocker resolution before aborting (1-120)."
        },
        "workermill.pushAfterCommit": {
          "type": "boolean",
          "default": true,
          "description": "Push to remote after each commit."
        },
        "workermill.qualityGateEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable quality gates (typecheck, lint, tests) before PR creation."
        },
        "workermill.blockOnTypeErrors": {
          "type": "boolean",
          "default": true,
          "description": "Block PR creation on TypeScript type-check errors."
        },
        "workermill.blockOnTestFailures": {
          "type": "boolean",
          "default": false,
          "description": "Block PR creation on test failures."
        },
        "workermill.blockOnLintErrors": {
          "type": "boolean",
          "default": true,
          "description": "Block PR creation on lint errors (ruff, eslint, etc.)."
        },
        "workermill.blockOnE2EFailures": {
          "type": "boolean",
          "default": false,
          "description": "Block PR creation on E2E test failures."
        },
        "workermill.autoFixEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically attempt to fix quality gate failures before blocking."
        },
        "workermill.autoFixMaxIterations": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Max auto-fix attempts before failing the quality gate (1-10)."
        },
        "workermill.maxParallelExperts": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum parallel worker agents for epic execution (1-16)."
        },
        "workermill.maxStories": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum stories the planner can create per task (1-20)."
        },
        "workermill.maxTargetFiles": {
          "type": "number",
          "default": 20,
          "minimum": 3,
          "maximum": 50,
          "description": "Recommended max files per story. Soft guideline (3-50)."
        },
        "workermill.selfReviewEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Workers review their own changes before committing."
        },
        "workermill.blockerAutoRetryEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically retry when a worker hits a blocker."
        },
        "workermill.gracefulShutdownEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow workers to finish current work before stopping."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "workermill.getStarted",
        "title": "Get Started with WorkerMill",
        "description": "Set up AI coding agents that plan, execute, and deliver pull requests from your editor.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to WorkerMill",
            "description": "Learn how WorkerMill orchestrates AI coding agents to plan, execute, and deliver pull requests.\n\n[Open Documentation](https://github.com/jarod-rosenthal/workermill#readme)",
            "media": {
              "markdown": "media/walkthrough-welcome.md"
            }
          },
          {
            "id": "signIn",
            "title": "Sign In",
            "description": "Connect your account to get started. Choose one:\n\n[Sign in with GitHub](command:workermill.signUpWithGitHub)\n[Sign in with Google](command:workermill.signInWithGoogle)\n\nSelf-hosting? [Connect to Local Instance](command:workermill.connectAgent)",
            "media": {
              "markdown": "media/walkthrough-signin.md"
            },
            "completionEvents": [
              "onContext:workermill.agentConfigured"
            ]
          },
          {
            "id": "connectRepo",
            "title": "Connect a Repository",
            "description": "Give workers access to read code, create branches, and open pull requests.\n\n[Open Settings](command:workermill.openSettings)",
            "media": {
              "markdown": "media/walkthrough-repo.md"
            },
            "completionEvents": [
              "onCommand:workermill.configureScm"
            ]
          },
          {
            "id": "configure",
            "title": "Configure AI & Quality",
            "description": "Choose your AI models, set quality gates, and connect issue trackers.\n\n[Open Settings](command:workermill.openSettings)",
            "media": {
              "markdown": "media/walkthrough-configure.md"
            },
            "completionEvents": [
              "onCommand:workermill.openSettings"
            ]
          },
          {
            "id": "runTask",
            "title": "Run Your First Task",
            "description": "Send a task to AI workers — from an issue key, a markdown file, or the dashboard.\n\n[Run a Task](command:workermill.runTask)\n[Browse Issues](command:workermill.searchIssues)",
            "media": {
              "markdown": "media/walkthrough-task.md"
            },
            "completionEvents": [
              "onCommand:workermill.runTask",
              "onCommand:workermill.runFileAsTask",
              "onCommand:workermill.searchIssues"
            ]
          },
          {
            "id": "productBuild",
            "title": "Build from a Product Spec",
            "description": "Right-click any `.md` file and select **WorkerMill: Product Build** to decompose a spec into stories and execute them.\n\n[Learn More](https://workermill.com/docs/epics)",
            "media": {
              "markdown": "media/walkthrough-prd.md"
            },
            "completionEvents": [
              "onCommand:workermill.buildFromPrd"
            ]
          },
          {
            "id": "monitor",
            "title": "Monitor & Review",
            "description": "Watch workers execute in real time — live logs, code diffs, and coordination messages.\n\n[Show Team Panel](command:workermill.showTeamPanel)\n[Open Dashboard](command:workermill.openDashboard)",
            "media": {
              "markdown": "media/walkthrough-monitor.md"
            },
            "completionEvents": [
              "onCommand:workermill.showTaskLogs",
              "onCommand:workermill.showTeamPanel"
            ]
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "workermill.teamPanel",
        "contents": "AI coding agents that plan, execute, and deliver pull requests — right from your editor.\n\n[Sign in with GitHub](command:workermill.signUpWithGitHub)\n[Sign in with Google](command:workermill.signInWithGoogle)\n\n[Connect to Local Instance](command:workermill.connectAgent)\n\n[Get Started Walkthrough](command:workbench.action.openWalkthrough?%22workermill.workermill%2Fworkermill.getStarted%22) · [Documentation](https://github.com/jarod-rosenthal/workermill#readme)",
        "when": "!workermill.agentConfigured"
      },
      {
        "view": "workermill.teamPanel",
        "contents": "WorkerMill agent is not connected.\n\n[Connect](command:workermill.connectAgent)\n\n[Reconfigure](command:workermill.signInWithGitHub) · [Open Dashboard](command:workermill.openDashboard)",
        "when": "workermill.agentConfigured && !workermill.agentConnected"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outdir=dist --external:vscode --format=cjs --platform=node --minify --tree-shaking=true --mangle-props=/_$/ --legal-comments=none",
    "watch": "esbuild src/extension.ts --bundle --outdir=dist --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies --allow-package-secrets github"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
