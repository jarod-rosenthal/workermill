***REMOVED***!/bin/bash
***REMOVED*** Pre-commit hook to prevent secrets from being committed
***REMOVED*** Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

RED='\033[0;31m'
NC='\033[0m' ***REMOVED*** No Color

***REMOVED*** Files to block entirely
BLOCKED_PATTERNS=(
    "tfplan"
    "*.tfplan"
    "*.tfstate"
    "terraform.tfstate*"
    ".env"
    "*.pem"
    "*.key"
    "id_rsa*"
    "*.p12"
    "credentials.json"
)

***REMOVED*** Patterns that indicate secrets in file content
SECRET_PATTERNS=(
    "AKIA[0-9A-Z]{16}"                    ***REMOVED*** AWS Access Key ID
    "sk-ant-[a-zA-Z0-9-]{20,}"            ***REMOVED*** Anthropic API Key
    "ghp_[a-zA-Z0-9]{36}"                 ***REMOVED*** GitHub Personal Access Token
    "gho_[a-zA-Z0-9]{36}"                 ***REMOVED*** GitHub OAuth Token
    "github_pat_[a-zA-Z0-9_]{22,}"        ***REMOVED*** GitHub PAT (new format)
    "xox[baprs]-[0-9a-zA-Z-]{10,}"        ***REMOVED*** Slack tokens
    "-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----"  ***REMOVED*** Private keys
)

echo "Running pre-commit security checks..."

***REMOVED*** Check for blocked file patterns
for pattern in "${BLOCKED_PATTERNS[@]}"; do
    ***REMOVED*** Get staged files matching the pattern
    matches=$(git diff --cached --name-only | grep -E "$pattern" 2>/dev/null)
    if [ -n "$matches" ]; then
        echo -e "${RED}ERROR: Blocked file pattern detected: $pattern${NC}"
        echo "$matches"
        echo ""
        echo "These files should not be committed. Remove them with:"
        echo "  git reset HEAD <file>"
        exit 1
    fi
done

***REMOVED*** Check staged file contents for secret patterns
for pattern in "${SECRET_PATTERNS[@]}"; do
    ***REMOVED*** Search staged changes for the pattern
    matches=$(git diff --cached -G"$pattern" --name-only 2>/dev/null)
    if [ -n "$matches" ]; then
        echo -e "${RED}ERROR: Potential secret detected matching pattern: $pattern${NC}"
        echo "In files:"
        echo "$matches"
        echo ""
        echo "Please remove secrets before committing."
        echo "If this is a false positive, you can bypass with: git commit --no-verify"
        exit 1
    fi
done

***REMOVED*** Check for large files that might be binary secrets/state
for file in $(git diff --cached --name-only); do
    if [ -f "$file" ]; then
        size=$(wc -c < "$file" 2>/dev/null || echo 0)
        ***REMOVED*** Block files over 1MB that aren't in expected locations
        if [ "$size" -gt 1048576 ]; then
            if [[ ! "$file" =~ ^(node_modules|dist|build|\.next)/ ]]; then
                echo -e "${RED}ERROR: Large file detected (>1MB): $file${NC}"
                echo "Large files may contain embedded secrets or state."
                echo "If intentional, bypass with: git commit --no-verify"
                exit 1
            fi
        fi
    fi
done

echo "Security checks passed."
exit 0
